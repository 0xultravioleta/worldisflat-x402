# Flat Fee configuration. Copy to .env (gitignored) and fill in. Never commit real keys.

# robinhood-testnet (default) or robinhood (mainnet, real USDG)
NETWORK=robinhood-testnet
# optional: your own RPC (defaults to the official public RPC of the network)
RPC_URL=
# Ultravioleta's x402 facilitator (settles USDG on Robinhood Chain and pays the gas)
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# the wallet that receives the USDG (required)
PAY_TO=0x0000000000000000000000000000000000000000

# prices in USDG (6 decimals); holders of WIF_HOLDER_MIN $WIF pay the holder price
PRICE_ASK_USDG=0.10
PRICE_ASK_HOLDER_USDG=0.05
PRICE_HIRE_USDG=0.50
PRICE_HIRE_HOLDER_USDG=0.25

# $WIF (mainnet token is built in; on testnet set WIF_ADDRESS (the token contract) to enable the tier and the cashback)
WIF_ADDRESS=
WIF_HOLDER_MIN=100
# $WIF sent back to the payer after every settled call, and to the human who completes a task.
# 0 turns them off. Turning either on needs MERCHANT_PRIVATE_KEY (a wallet holding $WIF and a little ETH for gas).
WIF_CASHBACK=0
WIF_WORKER_REWARD=0
MERCHANT_PRIVATE_KEY=
# shared secret for the human worker console (required when WIF_WORKER_REWARD > 0)
WORKER_TOKEN=

# the buyer used by `npm run buy` / `npm run e2e:*` (a wallet holding USDG on the network above)
PAYER_PRIVATE_KEY=

PORT=3000
# public URL when deployed, so the 402 advertises the right resource
PUBLIC_URL=
DATA_DIR=data
