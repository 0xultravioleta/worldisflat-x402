# Flat Fee configuration. Copy to .env (gitignored) and fill in. Never commit real keys.

# robinhood-testnet (default) or robinhood (mainnet, real USDG)
NETWORK=robinhood-testnet
# optional: your own RPC (defaults to the official public RPC of the network)
RPC_URL=
# Ultravioleta's x402 facilitator (settles USDG on Robinhood Chain and pays the gas)
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# the wallet that receives the USDG (required)
PAY_TO=0x0000000000000000000000000000000000000000

# prices in USDG (6 decimals); holders of WIF_HOLDER_MIN $WIF pay the holder price
PRICE_ASK_USDG=0.10
PRICE_ASK_HOLDER_USDG=0.05
PRICE_HIRE_USDG=0.50
PRICE_HIRE_HOLDER_USDG=0.25

# $WIF (mainnet token is built in; on testnet set WIF_ADDRESS (the token contract) to enable the tier and the cashback)
WIF_ADDRESS=
WIF_HOLDER_MIN=100
# $WIF sent back to the payer after a settled call, and to the human who completes a task.
# 0 turns them off. Turning either on needs MERCHANT_PRIVATE_KEY (a wallet holding $WIF and a little ETH for gas).
# `npm run e2e:mainnet` needs WIF_CASHBACK=10: it will not settle USDG on mainnet without the $WIF leg.
WIF_CASHBACK=0
WIF_WORKER_REWARD=0
# the most $WIF the server sends per UTC day, cashback and rewards together (kept in DATA_DIR/state.json)
WIF_DAILY_BUDGET=500
MERCHANT_PRIVATE_KEY=
# shared secret for the human worker console; without it "hire a human" and the task board are off (board mode)
WORKER_TOKEN=

# Hire a human through Execution Market instead of the board (docs/EXECUTION-MARKET.md). Off by default.
# On: Flat Fee publishes each paid hire on Execution Market, the merchant wallet (MERCHANT_PRIVATE_KEY, which then also
# needs USDG for the bounties) pays a USDG escrow per task, Flat Fee approves the delivery and sends WIF_WORKER_REWARD.
EM_HIRE=off
# Execution Market's API origin, e.g. https://api.execution.market (required when on)
EM_API_URL=
# the worker's bounty locked in escrow per task; at most PRICE_HIRE_HOLDER_USDG
EM_BOUNTY_USDG=0.20
EM_DEADLINE_HOURS=24
EM_POLL_SECONDS=30
EM_PAYMENT_TOKEN=USDG
# the escrow contracts on NETWORK, as deployed for Execution Market (required when on); nothing is signed for others
EM_ESCROW_ADDRESS=
EM_OPERATOR_ADDRESS=
EM_TOKEN_COLLECTOR_ADDRESS=
# where the reputation of these tasks lands (robinhood: the chain that paid; empty lets EM decide)
EM_REPUTATION_NETWORK=

# the buyer used by `npm run buy` / `npm run e2e:*` (a wallet holding USDG on the network above)
PAYER_PRIVATE_KEY=

# `npm run e2e:hire` (docs/EXECUTION-MARKET.md): the running server to buy from, and the test hire's worker on
# Execution Market: erc8128 (WORKER_PRIVATE_KEY, and WORKER_EM_CLIENT as the operator approved), token (WORKER_EM_TOKEN
# and WORKER_WALLET) or manual (WORKER_WALLET). It also needs RPC_URL (a private RPC) and the CONFIRM_MAINNET_* amounts.
FLATFEE_URL=
WORKER_MODE=
WORKER_PRIVATE_KEY=
WORKER_EM_CLIENT=
WORKER_WALLET=
WORKER_EM_TOKEN=
# `npm run em:register`: CONFIRM_EM_REGISTER=<the merchant's address> sends the one registration (a dry run without it)
CONFIRM_EM_REGISTER=

PORT=3000
# public URL when deployed, so the 402 advertises the right resource
PUBLIC_URL=
DATA_DIR=data
