# The live demo's container environment with hiring through Execution Market on (docs/EXECUTION-MARKET.md, "Turning
# it on in the deploy"). No secrets here: MERCHANT_PRIVATE_KEY and WORKER_TOKEN keep the values the container already
# has. test/deploy.test.ts loads this file with loadConfig, checks every EM_* value against Execution Market's recorded
# payment-config for Robinhood Chain (test/fixtures/em-payment-config.json) and that each key reaches the container in
# deploy/aws/main.tf. To turn it off at once: EM_HIRE=off, nothing else (every other EM_* is then not read).

# already on the container (unchanged), except PUBLIC_URL
NETWORK=robinhood
PAY_TO=0xb9056196d3D00b4c09ec2E5E123E30b376d39cC6
PORT=3000
# the host the judges open: the 402's `resource` names it (the only thing PUBLIC_URL sets)
PUBLIC_URL=https://flatfee.ultravioletadao.xyz
WIF_CASHBACK=10
WIF_WORKER_REWARD=50
WIF_DAILY_BUDGET=500

# new: hire a human through Execution Market on Robinhood Chain, paid from a USDG escrow
EM_HIRE=on
EM_API_URL=https://api.execution.market
# EM's escrow on Robinhood Chain, as GET /api/v1/h2a/payment-config serves it (escrow.networks.robinhood)
EM_ESCROW_ADDRESS=0xBdEA0D1bcC5966192B070Fdf62aB4EF5b4420cff
EM_OPERATOR_ADDRESS=0x0258472A1410Ac3Ad720f1BC83f22B3c0af1Fd9D
EM_TOKEN_COLLECTOR_ADDRESS=0x0E3dF9510de65469C4518D7843919c0b8C7A7757
EM_PAYMENT_TOKEN=USDG
# the worker's bounty, locked by the merchant wallet per hire; at most PRICE_HIRE_HOLDER_USDG (0.25)
EM_BOUNTY_USDG=0.20
EM_DEADLINE_HOURS=24
EM_POLL_SECONDS=30
# the ratings of these tasks land on the chain that paid (EM registers ERC-8004 on Robinhood Chain in production:
# GET /api/v1/reputation/register/wallet/{wallet}?network=robinhood answers, an unsupported network answers 400)
EM_REPUTATION_NETWORK=robinhood
