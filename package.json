{
  "name": "flat-fee",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-call agent answers and hire-a-human tasks priced in USDG over x402 on Robinhood Chain, with $WIF cashback and holder pricing.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "buy": "tsx scripts/buy.ts",
    "e2e:fork": "tsx scripts/e2e-fork.ts",
    "e2e:testnet": "tsx scripts/e2e-live.ts robinhood-testnet",
    "e2e:mainnet": "tsx scripts/e2e-live.ts robinhood",
    "verify:testnet": "tsx scripts/verify-testnet.ts",
    "balances": "tsx scripts/balances.ts",
    "reset": "tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "demo": "tsx scripts/demo-fork.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "ethers": "6.17.0",
    "hono": "4.13.13",
    "tsx": "4.23.15",
    "uvd-x402-sdk": "2.106.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
